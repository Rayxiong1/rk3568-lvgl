prefix=/home/gec/Desktop/freetype_lib
exec_prefix=/home/gec/Desktop/freetype_lib
libdir=/home/gec/Desktop/freetype_lib/lib
includedir=/home/gec/Desktop/freetype_lib/include

Name: FreeType 2
URL: https://freetype.org
Description: A free, high-quality, and portable font engine.
Version: 23.0.17
Requires:
Requires.private: zlib, libpng
Libs: -L${libdir} -lfreetype
Libs.private: -lbz2
Cflags: -I${includedir}/freetype2
